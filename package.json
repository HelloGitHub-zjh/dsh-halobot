{
  "name": "dsh-halobot",
  "version": "3.7.0",
  "description": "哈洛（Halobot）：住在 QQ 里的 AI 伙伴，DeepSeek Harness 插件（源自 Aurabot 1.1.24 的独立分支）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot",
    "halobot"
  ],
  "files": [
    "extensions",
    "src",
    "client",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/USER-MANUAL.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HelloGitHub-zjh/dsh-halobot.git"
  },
  "homepage": "https://github.com/HelloGitHub-zjh/dsh-halobot",
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/HelloGitHub-zjh/dsh-halobot/issues"
  }
}
