{
  "name": "dsh-dafeiyu",
  "version": "2.0.0",
  "description": "大肥鱼：独立维护的 QQ 伙伴插件（基于 Aurabot 1.1.24 分叉，本人维护，与上游无同步关系）",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "qq",
    "onebot"
  ],
  "files": [
    "extensions",
    "src",
    "client",
    "personas",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "docs/USER-MANUAL.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CHANGE-ME/dsh-dafeiyu.git"
  },
  "homepage": "https://github.com/CHANGE-ME/dsh-dafeiyu",
  "engines": {
    "node": ">=22.13.0"
  },
  "bugs": {
    "url": "https://github.com/CHANGE-ME/dsh-dafeiyu/issues"
  }
}
